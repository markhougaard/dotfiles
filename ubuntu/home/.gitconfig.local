# Ubuntu-specific git config, included from the end of the shared ~/.gitconfig.
[core]
	editor = vim
# The signing key lives only on the Mac, so the server commits unsigned.
[commit]
	gpgsign = false
[tag]
	gpgsign = false

# Get GitHub credentials from the gh CLI (written by `gh auth setup-git`).
# The empty helper first clears any helpers set earlier.
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
