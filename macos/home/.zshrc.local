# macOS-specific zsh config, sourced from the end of the shared ~/.zshrc.

# Use VS Code as "$EDITOR".
export VISUAL="code -w"
export EDITOR="$VISUAL"

# Colorised BSD ls.
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

# No rupa/z here. The zsh-z plugin in the shared .zshrc provides `z` on both
# platforms and reads the same ~/.z datafile, so one implementation covers both
# and the jump history carries over.

# macOS notification from the shell.
function notif() {
  osascript -e 'display notification "Done" with title "🎉"'
}
