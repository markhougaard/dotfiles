# Brewfile — everything installed on this Mac, and nothing more.
#
#   brew bundle --file=macos/Brewfile          install everything listed
#   brew bundle check --file=macos/Brewfile    report what's missing
#   brew bundle cleanup --file=macos/Brewfile  list installed things NOT here
#
# cleanup also lists superseded keg versions (e.g. python@3.12/3.12.9 while
# 3.12.14 is installed) - that is normal and safe. Read its output before
# --force anyway: it removes orphaned dependencies too, and an older installed
# build may still link against one the current formula no longer declares.
#
# Only top-level packages are listed; Homebrew resolves dependencies itself.
# Regenerate the installed-state portion with: brew bundle dump --force

# Third-party taps. Homebrew hides a tap's formulae from `brew leaves` until the
# tap is trusted, so trust this one or `ticket` will look uninstalled:
#   brew trust --formula wedow/tools/ticket
tap "wedow/tools"

